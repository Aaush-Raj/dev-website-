# ---------------------------------------------------------------------------
# Copy to .env.local for local development. .env.local is gitignored.
# ---------------------------------------------------------------------------

# Canonical site origin, no trailing slash.
# Drives canonical URLs, Open Graph tags, sitemap.xml and robots.txt.
# Production builds set this to https://elurny.com (Dockerfile ARG).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# BACKEND. The site now runs as a Next.js server (next.config.ts:
# output "standalone"), so these are LIVE — the forms and the Trust Centre
# both depend on them.
# ---------------------------------------------------------------------------

# MongoDB connection string. Local: mongodb://127.0.0.1:27017
# Production: the Atlas SRV string, injected as a Kubernetes secret.
MONGODB_URI=mongodb://127.0.0.1:27017

# Database name. Leads go to its `leads` collection; Trust Centre sign-ins and
# downloads to `trust_centre_audit`.
MONGODB_DB=elurny

# Where demo requests and contact enquiries are announced.
# Comma-separated for several recipients.
LEADS_NOTIFY_TO=
# Must be an address on a domain verified with the email provider.
LEADS_NOTIFY_FROM=Lurny Website <website@elurny.com>

# Email provider. With no key the lead is still saved and the notification is
# logged and recorded as unsent, so nothing is lost while this is blank.
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# TRUST CENTRE (/trust-centre) — the credentialed document portal.
#
# Naming note: everything here is TRUST_CENTRE_*, deliberately separate from
# any future end-user login. This is ONE shared credential for client
# reviewers, not a user account system, and the two must never share a secret,
# a cookie or a code path.
#
# THE ACCOUNT IS CREATED AUTOMATICALLY ON FIRST BOOT.
# There is no setup command. The server creates the reviewer account in
# MongoDB if it does not already exist, and leaves it untouched if it does —
# so changing the password in the database is permanent and a redeploy will
# never revert it.
# ---------------------------------------------------------------------------

# The reviewer sign-in address. Defaults to ayush@lurny.ai when unset.
# Changing this and restarting RENAMES the existing account rather than
# creating a second one.
TRUST_CENTRE_EMAIL=ayush@lurny.ai

# THE LIVE PASSWORD. This is the source of truth: on every startup the stored
# account is reconciled against it, so changing this and restarting changes the
# credential. Leave it UNSET if you would rather manage the password in the
# database with `npm run trust-centre:password`.
#
# REQUIRED unless TRUST_CENTRE_ALLOW_DEV_PASSWORD=true below. With neither
# set, no account is created and nobody can sign in — it fails closed.
TRUST_CENTRE_PASSWORD=

# Set to "true" for LOCAL DEVELOPMENT ONLY to seed the account with the
# default password that is public in the repository (see account.ts). Never
# set this in production. Ignored whenever TRUST_CENTRE_PASSWORD is set.
TRUST_CENTRE_ALLOW_DEV_PASSWORD=

# Signs session cookies. >= 32 chars, and NOT the password.
# Generate one with: openssl rand -base64 48
# Changing it signs everyone out at once, which is how you revoke access fast.
TRUST_CENTRE_SECRET=

# Shown in the portal header and recorded in the audit log.
TRUST_CENTRE_ACCOUNT_LABEL=Lurny

# ---------------------------------------------------------------------------
# AZURE BLOB STORAGE — where the documents actually live.
#
# The container MUST be created with public access OFF. The portal serves
# every document through a 5-minute SAS URL signed per request, which only
# works if the container is private:
#   az storage container create -n lurny-trust-centre \
#      --account-name <account> --public-access off
# ---------------------------------------------------------------------------

AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
TRUST_CENTRE_CONTAINER=lurny-trust-centre

# Override only for Azurite or a private endpoint. Defaults to
# https://<account>.blob.core.windows.net
AZURE_STORAGE_ENDPOINT=
